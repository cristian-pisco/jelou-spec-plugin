{
  "name": "jelou-spec-plugin",
  "version": "0.3.238",
  "description": "Spec-driven development plugin for Claude Code with TDD, multi-service coordination, and specialized agents",
  "author": "Jelou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "claude-code",
    "plugin",
    "spec-driven-development",
    "tdd",
    "multi-service"
  ],
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "sync-agents": "node bin/sync-agents.mjs",
    "sync-codex": "node bin/sync-codex.mjs",
    "sync": "node bin/sync-agents.mjs && node bin/sync-codex.mjs",
    "check-sync": "node bin/sync-agents.mjs --check && node bin/sync-codex.mjs --check",
    "prepare": "bash bin/install-git-hooks.sh"
  }
}
