{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/bin/guard-test-commands.mjs\"",
            "statusMessage": "jlu: checking test-command worker caps"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/bin/guard-env-reads.mjs\"",
            "statusMessage": "jlu: checking for .env secret exposure"
          }
        ]
      }
    ]
  }
}
