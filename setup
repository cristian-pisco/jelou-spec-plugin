#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_DIR="$SCRIPT_DIR"

INSTALL_CLAUDE="true"
INSTALL_OPENCODE="true"
INSTALL_CODEX="true"
HOST_FILTERED="false"
OPENCODE_TARGET="${OPENCODE_HOME:-$HOME/.config/opencode}"
CODEX_TARGET="${CODEX_HOME:-$HOME/.codex}"
NO_GLOBAL_OPENCODE="false"
NO_GLOBAL_CODEX="false"
LEGACY_COPY="false"
declare -a OPENCODE_PROJECTS=()

usage() {
  cat <<'USAGE'
Jelou Spec Plugin setup

Usage:
  ./setup [options]

Options:
  --host <claude|opencode|codex> Select install target (repeatable). Default: all.
  --opencode-target <path>      Global OpenCode config path (default: ~/.config/opencode)
  --codex-target <path>         Global Codex config path (default: ~/.codex)
                                Skills install to ~/.agents/skills, where Codex looks
                                for them; set CODEX_SKILLS_DIR to redirect those too.
  --project <path>              Also install OpenCode files into a project (repeatable)
  --no-opencode-global          Skip install into --opencode-target
  --no-codex-global             Skip install into --codex-target
  --legacy-copy                 Claude Code only: copy skills and agents into
                                ~/.claude instead of relying on the plugin
                                system. They install unnamespaced, shadow the
                                plugin's jlu: surfaces, and are not removed by
                                a later plugin update. Only for a Claude Code
                                too old to support plugins.
  -h, --help                    Show this help

Examples:
  ./setup
  ./setup --host claude
  ./setup --host claude --host opencode --host codex
  ./setup --host opencode --project /path/to/repo
  ./setup --host codex
For a Codex project-local install: bin/install-codex.sh /path/to/repo
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host)
      [ "$#" -lt 2 ] && { echo "Error: --host requires a value" >&2; exit 2; }
      if [ "$HOST_FILTERED" = "false" ]; then
        INSTALL_CLAUDE="false"
        INSTALL_OPENCODE="false"
        INSTALL_CODEX="false"
        HOST_FILTERED="true"
      fi
      case "$2" in
        claude) INSTALL_CLAUDE="true" ;;
        opencode) INSTALL_OPENCODE="true" ;;
        codex) INSTALL_CODEX="true" ;;
        *)
          echo "Error: --host must be one of: claude, opencode, codex" >&2
          exit 2
          ;;
      esac
      shift 2
      ;;
    --opencode-target)
      [ "$#" -lt 2 ] && { echo "Error: --opencode-target requires a path" >&2; exit 2; }
      OPENCODE_TARGET="$2"
      shift 2
      ;;
    --project)
      [ "$#" -lt 2 ] && { echo "Error: --project requires a path" >&2; exit 2; }
      OPENCODE_PROJECTS+=("$2")
      shift 2
      ;;
    --no-opencode-global)
      NO_GLOBAL_OPENCODE="true"
      shift
      ;;
    --codex-target)
      [ "$#" -lt 2 ] && { echo "Error: --codex-target requires a path" >&2; exit 2; }
      CODEX_TARGET="$2"
      shift 2
      ;;
    --no-codex-global)
      NO_GLOBAL_CODEX="true"
      shift
      ;;
    --legacy-copy)
      LEGACY_COPY="true"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown option '$1'" >&2
      usage >&2
      exit 2
      ;;
  esac
done

declare -a ACTIVE_HOSTS=()
[ "$INSTALL_CLAUDE" = "true" ] && ACTIVE_HOSTS+=("claude")
[ "$INSTALL_OPENCODE" = "true" ] && ACTIVE_HOSTS+=("opencode")
[ "$INSTALL_CODEX" = "true" ] && ACTIVE_HOSTS+=("codex")
HOST_LABEL="${ACTIVE_HOSTS[*]}"

echo "=== Jelou Spec Plugin Setup ==="
echo "Plugin: $PLUGIN_DIR"
echo "Host:   $HOST_LABEL"
echo

if command -v node >/dev/null 2>&1 && [ -f "$PLUGIN_DIR/bin/sync-agents.mjs" ]; then
  echo "Syncing runtime mirrors (OpenCode + Codex)..."
  (cd "$PLUGIN_DIR" && node bin/sync-agents.mjs >/dev/null && node bin/sync-codex.mjs >/dev/null)
  echo "  done"
else
  echo "Syncing runtime mirrors... skipped (node not found)"
fi

report_claude_plugin_state() {
  local claude_bin="${JLU_CLAUDE_CLI:-claude}"
  echo "Claude Code loads this plugin through the plugin system — no file copy needed."
  if command -v "$claude_bin" >/dev/null 2>&1 &&
     "$claude_bin" plugin list --json 2>/dev/null | grep -q '"jlu@jelou-spec-plugin"'; then
    echo "  jlu@jelou-spec-plugin is installed. Run /jlu-update to pull the latest version."
  else
    echo "  jlu@jelou-spec-plugin is not installed yet:"
    echo "    claude plugin marketplace add cristian-pisco/jelou-spec-plugin"
    echo "    claude plugin install jlu@jelou-spec-plugin"
  fi
  echo "  To exercise this working tree before releasing:"
  echo "    claude --plugin-dir \"$PLUGIN_DIR\""
}

if [ "$INSTALL_CLAUDE" = "true" ]; then
  echo
  if [ "$LEGACY_COPY" = "true" ]; then
    echo "Installing for Claude Code (legacy copy)..."
    JLU_SKIP_SYNC_AGENTS=true "$PLUGIN_DIR/bin/install.sh"
  else
    report_claude_plugin_state
  fi
fi

if [ "$INSTALL_OPENCODE" = "true" ]; then
  if [ "$NO_GLOBAL_OPENCODE" = "false" ]; then
    echo
    echo "Installing for OpenCode (global): $OPENCODE_TARGET"
    mkdir -p "$OPENCODE_TARGET"
    "$PLUGIN_DIR/bin/install-opencode.sh" "$OPENCODE_TARGET"
  fi

  if [ "${#OPENCODE_PROJECTS[@]}" -gt 0 ]; then
    for project in "${OPENCODE_PROJECTS[@]}"; do
      echo
      echo "Installing for OpenCode project: $project"
      "$PLUGIN_DIR/bin/install-opencode.sh" "$project"
    done
  fi
fi

if [ "$INSTALL_CODEX" = "true" ] && [ "$NO_GLOBAL_CODEX" = "false" ]; then
  echo
  echo "Installing for Codex (global): $CODEX_TARGET"
  CODEX_HOME="$CODEX_TARGET" "$PLUGIN_DIR/bin/install-codex.sh"
fi

echo
echo "Setup complete."
echo "Run this same command after pulling updates to refresh your local installs."
